SAMBATUI_SERVER=dc01.example.com
SAMBATUI_DOMAIN=example.com
SAMBATUI_ZONE=example.com
SAMBATUI_USER=administrator@example.com
SAMBATUI_AUTH=password
SAMBATUI_KERBEROS=off
SAMBATUI_KRB5_CCACHE=
SAMBATUI_CONFIGFILE=
SAMBATUI_OPTIONS=
SAMBATUI_LDAP_BASE=DC=example,DC=com
SAMBATUI_LDAP_ENCRYPTION=ldaps
SAMBATUI_LDAP_COMPATIBILITY=off
SAMBATUI_AUTO_PTR=ask
SAMBATUI_SMART_DAYS=90
SAMBATUI_SMART_DISABLED_DAYS=180
SAMBATUI_SMART_NEVER_LOGGED_DAYS=30
SAMBATUI_SMART_MAX_ROWS=500
SAMBATUI_PASSWORD=replace-with-your-password
# SAMBATUI_PASSWORD_FILE=~/.config/sambatui/password
# SAMBATUI_USER_CONFIG=~/.config/sambatui/config.toml
