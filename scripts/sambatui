#!/usr/bin/env bash
# Docker options supplied to this launcher are inserted before the image name.
set -euo pipefail

if [[ ! -t 0 || ! -t 1 ]]; then
    printf '%s\n' 'sambatui requires an interactive terminal.' >&2
    exit 1
fi

env_args=(--env "TERM=${TERM:-xterm-256color}")
while IFS= read -r name; do
    case "$name" in
        SAMBATUI_*|COLORTERM|TEXTUAL_THEME|KRB5CCNAME)
            env_args+=(--env "$name") ;;
    esac
done < <(compgen -e)

exec docker run --rm -it --init --read-only \
    --cap-drop ALL --security-opt no-new-privileges:true \
    --tmpfs /tmp:rw,noexec,nosuid,nodev,mode=1777,size=128m \
    --mount "type=volume,src=${SAMBATUI_DOCKER_VOLUME:-sambatui-config},dst=/home/app/.config/sambatui" \
    "${env_args[@]}" "$@" "${SAMBATUI_IMAGE:-sambatui:local}"
